# ============================================================
# Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# On Vercel, add these as Environment Variables in the dashboard.
# On Netlify, add them in Site Settings → Environment Variables.
# ============================================================

# --- Supabase ---
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Google OAuth (for Supabase) ---
# Set up in Supabase: Dashboard → Authentication → Providers → Google
# You need a Google OAuth 2.0 credential from Google Cloud Console
# Redirect URL in Google Cloud: https://your-project.supabase.co/auth/v1/callback
# Redirect URL in Supabase: https://your-app.vercel.app/auth_callback.html
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Optional: Job API Keys ---
# These are optional — the app works without them
# JOOBLE_API_KEY=your-jooble-key
# ADZUNA_APP_ID=your-adzuna-app-id
# ADZUNA_APP_KEY=your-adzuna-app-key
# JOBS_API_KEY=your-jsearch-rapidapi-key